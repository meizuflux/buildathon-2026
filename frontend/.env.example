# Default (no env): the dev server hosts a shared mock API at /api that the
# partner portal (3rdparty branch) also uses, so both apps stay in sync.
# Demo logins use the password "haven-demo".

# Point /api at the real backend instead of the mock:
# HAVEN_API_URL=http://127.0.0.1:8000

# Keep all data in the browser (no server; for static demo builds):
# VITE_USE_MOCK=true
