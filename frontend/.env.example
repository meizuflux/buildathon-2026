EXPO_PUBLIC_DATA_MODE=mock
# Set this to the backend origin reachable from your device (no trailing /api/v1).
EXPO_PUBLIC_API_BASE_URL=
# Proposed change endpoint; set to disabled if unsupported.
EXPO_PUBLIC_CHANGES_PATH=/api/v1/changes

# Android standalone map builds only (restricted Android Maps SDK key).
# GOOGLE_MAPS_ANDROID_API_KEY=
