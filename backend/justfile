# List available recipes.
default:
    @just --list

# Run the development server with automatic reload.
dev:
    uv run --locked litestar --app haven.app:app run --reload

# Run the production server. Set HOST, PORT, and WEB_CONCURRENCY as needed.
prod:
    uv run --locked --no-dev uvicorn haven.app:app --no-proxy-headers --host "${HOST:-0.0.0.0}" --port "${PORT:-8000}"

# Initialize the schema, apply migrations, and reconcile stored plans.
schema:
    uv run --locked python -c 'import asyncio; from haven.startup import initialize_database; asyncio.run(initialize_database())'

# Generate TypeScript API types for the dashboard from the OpenAPI schema.
schema-typescript:
    uv run --locked litestar --app haven.app:app schema typescript --output ../frontend/src/api/api-specs.ts --namespace Haven

# Run the test suite.
test:
    uv run --locked pytest -q

# Check Python lint rules and formatting.
lint:
    uv run --locked ruff check src tests

format-check:
    uv run --locked ruff format --check src tests

format:
    uv run --locked ruff format src tests

# Check source types.
typecheck:
    uv run --locked ty check src

# Run all development checks.
check: lint format-check typecheck test

# Create an operator interactively (password is not echoed).
create-operator:
    uv run --locked python -m haven.create_operator

# Recreate the disposable SQLite database with fresh demo accounts and the Estates scenario.
demo-data:
    uv run --locked python -m haven.demo_data

# Compare allocation profiles without editing the app database.
analyze-allocation *args:
    uv run --locked python scripts/analyze_allocation.py {{args}}

# Preview updating only the curated demo shelter network (add --apply to change it).
refresh-demo-shelters *args:
    uv run --locked python -m haven.refresh_demo_shelters {{args}}
